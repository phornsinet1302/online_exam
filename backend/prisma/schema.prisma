generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  supabaseId  String   @unique
  email       String   @unique
  name        String
  avatarUrl   String?
  role        String   @default("teacher")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exams       Exam[]

  // ... other relations
}

enum Role {
  TEACHER
  STUDENT
  COLLABORATOR
  INVIGILATOR
}

model Exam {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      ExamStatus @default(DRAFT)
  ownerId     String    @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [supabaseId])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject     String?
  startDate   DateTime?
  duration    Int?
  timezone    String?
  passingScore Float?
  maxAttempts Int?

  randomizeQuestions Boolean @default(false)
  showResults        Boolean @default(false)

  accessType  ExamAccess @default(PUBLIC)
  password    String?

  sections        Section[]
  materials       Material[]
  attempts        ExamAttempt[]
  antiCheatRules  ExamAntiCheatRule[]

  uniqueCode           String?   @unique
  magicLinkToken       String?
  lateAllowanceMinutes Int @default(0)
  sessionState         ExamSessionState @default(WAITING)

  @@map("exams")
}

enum ExamSessionState {
  WAITING
  ACTIVE
  ENDED
}

enum ExamAccess {
  PUBLIC
  PRIVATE
  PASSWORD_PROTECTED
}

model ExamAttempt {
  id          String   @id @default(cuid())
  examId      String   @map("exam_id")
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String?  // if you have student accounts; or a session ID for anonymous
  startedAt   DateTime @default(now())
  submittedAt DateTime?
  score       Float?

  snapshot    Json     // Stores the full exam structure at start time (NO correct answers)
  answers     Json?    // Legacy: raw answers blob (kept for backward compat)
  gradingKey  Json?    // Private: correct answers keyed by questionId for server-side grading

  // Grading
  totalScore     Float?
  gradingStatus  GradingStatus?
  studentAnswers StudentAnswer[]
  violations     ViolationLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("exam_attempts")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GradingStatus {
  auto_graded
  needs_review
  graded
}

model Section {
  id             String   @id @default(cuid())
  examId         String   @map("exam_id")
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title          String
  order          Int      // display order
  randomization  Boolean  @default(false)
  shuffleAnswers Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questions   Question[]

  @@map("sections")
}

model Question {
  id            String       @id @default(cuid())
  sectionId     String       @map("section_id")
  section       Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type          QuestionType
  title         String?      // optional short title for the question
  description   String?      // optional description (can be rich text)
  text          String       // question stem
  points        Float        @default(1.0)
  difficulty    Difficulty
  order         Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  required      Boolean      @default(true)  // whether student must answer
  reviewed      Boolean      @default(false) // for AI-generated drafts
  metadata      Json?
  isAIGenerated Boolean      @default(false)

  options     Option[] // for MCQ/True-False

  @@map("questions")
}

enum QuestionType {
  MCQ
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILL_IN_BLANK
  MATCHING
  CHECKBOX
  FILE_UPLOAD
  MATH_FORMULA
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

model Option {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("options")
}

model Material {
  id        String   @id @default(cuid())
  examId    String   @map("exam_id")
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  content   String?  // text content
  fileUrl   String?  // if file uploaded, store URL
  createdAt DateTime @default(now())

  @@map("materials")
}

model StudentAnswer {
  id         String      @id @default(cuid())
  attemptId  String      @map("attempt_id")
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String      @map("question_id")

  // Raw answer from student
  selectedOptionIds String[]  // for MCQ, TRUE_FALSE, MULTIPLE_SELECT, CHECKBOX
  textAnswer        String?   // for SHORT_ANSWER, ESSAY, FILL_IN_BLANK, MATH_FORMULA
  matchingPairs     Json?     // for MATCHING: [{leftId, rightId}]
  fileUrl           String?   // for FILE_UPLOAD

  // Grading output
  score    Float?
  maxScore Float
  status   GradingStatus @default(needs_review)
  feedback String?       // teacher feedback for manual grading
  gradedBy String?       // teacher supabaseId
  gradedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_answers")
}

// ─── Anti-Cheat ───────────────────────────────────────────────────────────────

model ExamAntiCheatRule {
  id        String   @id @default(cuid())
  examId    String   @map("exam_id")
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  // eventType values:
  // tab_switch | copy | paste | right_click | keyboard_shortcut
  // fullscreen_exit | window_blur | devtools | print_screen
  // idle | disconnect_internet | disconnect_camera | disconnect_mic
  // resize | multiple_windows | extension_detected
  eventType String

  enabled   Boolean @default(true)
  // action: "ignore" | "warn" | "flag" | "block" | "auto_submit"
  action    String  @default("warn")
  // trigger action after N cumulative occurrences (null = every occurrence)
  threshold Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, eventType])
  @@map("exam_anti_cheat_rules")
}

model ViolationLog {
  id        String      @id @default(cuid())
  attemptId String      @map("attempt_id")
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examId    String      @map("exam_id")

  eventType String  // same values as ExamAntiCheatRule.eventType
  detail    String? // extra context, e.g. "Ctrl+C", "3 windows"

  // severity: "info" | "warn" | "critical"
  severity  String @default("warn")
  // action actually taken: "ignored" | "warned" | "flagged" | "blocked" | "auto_submitted"
  actionTaken String?

  // cumulative count of this eventType for this attempt at time of log
  occurrenceCount Int @default(1)

  resolved   Boolean  @default(false)
  resolvedBy String?  // teacher supabaseId
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@map("violation_logs")
}
